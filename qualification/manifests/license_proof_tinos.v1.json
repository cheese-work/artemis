{
  "manifest_version": 1,
  "issue": "CHE-3101",
  "sdk": "tinos",
  "journey": "qualification/journeys/license_proof_tinos.md",
  "runner": {
    "repository": "https://github.com/cheese-work/artemis",
    "base_sha": "41374d3d17888f968b4cefa095ac8e36f627e4ec"
  },
  "inputs": {
    "sample_repository": "https://github.com/tevo-studio/tinos-mobile",
    "sample_pr": 14,
    "sample_sha": "ee151046c072e39f127b1e7b0c4c17edc9dce570",
    "service_repository": "https://github.com/tevo-studio/tevo-license-mobile-sdk",
    "service_pr": 7,
    "service_sha": "f91c99e1645343819b56fee00ea1adea7aa55367",
    "service_image": "ghcr.io/tevo-studio/tevo-license-mobile-sdk@sha256:cfcf54ffbc989049d85bca3e74677cd4e42aca2ed8c5b244f5ba4c066b9d2d8b"
  },
  "app": {
    "package": "digital.tinos.sample.kotlin",
    "proof_variant": "licenseProof",
    "proof_variant_debuggable": false,
    "license_proof_port": 8080
  },
  "service": {
    "profile": "license-test",
    "mode": "enforce",
    "host": "congvc-X99",
    "license_test_port": 8080,
    "app_base_url": "http://10.0.2.2:8080",
    "fresh_tmpfs_database_per_suite": true,
    "admin_status_changes": "loopback /admin GET and /admin/status POST; require local test header, exact Origin, and observed package/certificate pair"
  },
  "scenarios": {
    "approved": "LicenseResult.Licensed; server row stays approved; zero SDK denial logs",
    "pending": "LicenseResult.NotLicensed; server row stays pending; one SDK denial log",
    "revoked": "LicenseResult.NotLicensed; server row stays revoked; one SDK denial log",
    "offline-no-cache": "LicenseResult.Unverified transport failure; app remains usable; service is stopped",
    "debug-pending": "NOT-RUN: debuggable client queues a background license fetch and returns LicenseResult.Licensed; compatible debug input unavailable"
  },
  "case_order": [
    "pending",
    "approved",
    "revoked",
    "debug-pending",
    "offline-no-cache"
  ],
  "observation": {
    "wait_timeout_seconds": 12,
    "case_log_scope": "new launch PID only; filter the SDK denial tag, level and message",
    "online_server_freshness": "record the pair last_seen before launch and require a strictly later value after launch",
    "denial_log": {
      "tag": "Tinos",
      "level": "WARN",
      "message_contains": "Not licensed"
    },
    "result_log": {
      "tag": "TinosSample",
      "level": "INFO",
      "message_contains_by_case": {
        "approved": "LicenseResult.Licensed",
        "pending": "LicenseResult.NotLicensed: digital.tinos.sample.kotlin",
        "revoked": "LicenseResult.NotLicensed: digital.tinos.sample.kotlin",
        "offline-no-cache": "LicenseResult.Unverified:",
        "debug-pending": "LicenseResult.Licensed"
      },
      "message_regex_by_case": {
        "approved": "LicenseResult\\.Licensed",
        "pending": "LicenseResult\\.NotLicensed: digital\\.tinos\\.sample\\.kotlin",
        "revoked": "LicenseResult\\.NotLicensed: digital\\.tinos\\.sample\\.kotlin",
        "offline-no-cache": "LicenseResult\\.Unverified:",
        "debug-pending": "LicenseResult\\.Licensed"
      }
    },
    "initialization_log": {
      "tag": "LicenseProof",
      "level": "INFO",
      "message_regex_by_case": {
        "approved": "init=proceeded",
        "pending": "init=denied",
        "revoked": "init=denied",
        "offline-no-cache": "init=proceeded"
      },
      "matches_per_case": 1,
      "same_launch_pid": true,
      "wait_timeout_seconds": 12,
      "source": "MainActivity.kt:43-44",
      "missing_or_duplicate_or_error_fails": true
    }
  },
  "initialization": {
    "coverage": "ASSERTED_PER_CASE"
  },
  "debug_case_input": {
    "required": "A debuggable variant that routes to the X99 license-test endpoint",
    "available_in_pinned_sources": false,
    "reason": "The pinned licenseProof variant is non-debuggable and defines the emulator HTTP endpoint only for that build type.",
    "disposition": "NOT-RUN in CHE-3101; device follow-up is CHE-9713"
  },
  "fixture_reset": {
    "before_each_case": "adb shell pm clear digital.tinos.sample.kotlin",
    "before_each_suite": "start a fresh task-owned Compose project with the license-test profile",
    "offline_case": "stop only the task-owned license-test service; this is the final case",
    "after_suite": "docker compose -p <task-project> --profile license-test down"
  },
  "evidence_per_case": [
    "logcat",
    "launch_pid",
    "screen",
    "server_row",
    "server_last_seen_before_after",
    "testcase_revision",
    "app_package",
    "device_serial",
    "command_exit_status",
    "fixture_cleanup_readback"
  ],
  "review": {
    "independent_non_author_reviewers_required": 2,
    "same_testcase_revision": true,
    "must_precede_device_execution": true
  }
}
