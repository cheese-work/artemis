{
  "name": "artemis-showcase-ui",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "node scripts/validate-whats-new.mjs && node scripts/write-build-info.mjs",
    "ng": "ng",
    "prestart": "node scripts/validate-whats-new.mjs && node scripts/write-build-info.mjs",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:preview": "node scripts/build-preview.mjs",
    "test:docker-build-inputs": "node scripts/test-docker-build-inputs.mjs",
    "test:keyboard": "node scripts/keyboard-walkthrough/walkthrough.mjs",
    "test:navigation": "node scripts/keyboard-walkthrough/walkthrough.mjs --navigation-only",
    "test:keyboard-paste": "node --test scripts/keyboard-walkthrough/paste-shortcut.test.mjs",
    "test:layout": "node scripts/layout-audit/layout-audit.mjs",
    "test:shell": "node scripts/responsive-shell.mjs",
    "test:run-header": "node scripts/run-header-audit.mjs",
    "test:step-timeline": "node scripts/run-header-audit.mjs --timeline",
    "test:controls": "node scripts/layout-audit/screenshots.mjs screenshots controls --controls",
    "test:device-pane": "node scripts/run-header-audit.mjs --evidence",
    "test:preview-path": "node scripts/preview-path.test.mjs",
    "test:build-info": "node --test scripts/write-build-info.test.mjs",
    "test:whats-new": "node --test scripts/validate-whats-new.test.mjs scripts/check-whats-new-entry.test.mjs",
    "prewatch": "node scripts/validate-whats-new.mjs && node scripts/write-build-info.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest": "node scripts/validate-whats-new.mjs && npm run test:whats-new && node scripts/lint-ui-strings.mjs && node scripts/lint-theme.mjs && node scripts/write-build-info.mjs && npm run test:build-info && npm run test:tango-stream-extra && npm run test:keyboard-paste",
    "test:tango-stream-extra": "node --test scripts/tango-stream-extra.test.mjs",
    "postinstall": "node scripts/patch-tango.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "2.6.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jasmine": "~5.1.0",
    "esbuild": "0.28.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
